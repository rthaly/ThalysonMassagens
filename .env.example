# Copie para .env.local para rodar no seu computador. Na Vercel, cadastre em Settings → Environment Variables.

# Supabase (login da área /gestao) — já devem existir no projeto da Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOVO: liga os horários reais do Google Calendar no site.
# O valor aparece em /gestao, no quadro "Horários reais no site", depois de autorizar o Google.
AGENDA_OWNER_USER_ID=

# Opcional: seu domínio próprio (ex.: https://relaxarhoje.com.br). Sem isso, usa o domínio de produção da Vercel.
NEXT_PUBLIC_SITE_URL=
